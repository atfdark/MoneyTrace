# MoneyTrace Environment Configuration

# Database URL
# For async SQLAlchemy connection with asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/moneytrace

# Secret key for JWT tokens (change in production!)
SECRET_KEY=super-secret-key-change-in-production

# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment: development | staging | production
ENVIRONMENT=development

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173
